# Docker Hub namespace used by the image names in Compose and scripts.
DOCKERHUB_NAMESPACE=parvesshikder

# Image tags.
IMAGE_TAG=latest
TEAM_IMAGE_TAG=latest
EVENT_SERVICE_IMAGE=mohoshena/event-service
VENUE_SERVICE_IMAGE=mohoshena/venue-service
USER_SERVICE_IMAGE=deb0tush/user-service
TICKETING_SERVICE_IMAGE=deb0tush/ticketing-service
CHECKIN_SERVICE_IMAGE=muhammadafaq1/attendee-checkin-service
ANALYTICS_SERVICE_IMAGE=muhammadafaq1/analytics-service

# Shared security settings. Use the same values in every service.
JWT_ISSUER=event-ticketing-gateway
JWT_SECRET=event-ticketing-development-secret-32
JWT_TTL_MINUTES=120
JWT_EXPIRATION=86400000

# Stripe test mode keys. Leave blank until you add real keys from your Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Gateway bootstrap admin.
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@event-ticketing.local
AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin123

# Host ports for the common stack.
FRONTEND_HOST_PORT=8088
API_GATEWAY_HOST_PORT=8080
BOOKING_SERVICE_HOST_PORT=18081
PAYMENT_SERVICE_HOST_PORT=18082
AUTH_DB_HOST_PORT=5435
BOOKING_DB_HOST_PORT=5433
PAYMENT_DB_HOST_PORT=5434
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# Host ports used when docker-compose.team.yml is enabled.
EVENT_SERVICE_HOST_PORT=8083
VENUE_SERVICE_HOST_PORT=8084
USER_SERVICE_HOST_PORT=8090
TICKETING_SERVICE_HOST_PORT=8091
CHECKIN_SERVICE_HOST_PORT=8086
REPORTING_SERVICE_HOST_PORT=8087
EVENT_DB_HOST_PORT=5436
VENUE_DB_HOST_PORT=5437
USER_DB_HOST_PORT=5438
TICKETING_DB_HOST_PORT=5439
CHECKIN_DB_HOST_PORT=5440
REPORTING_DB_HOST_PORT=5441
